# Copy to .env — NEVER commit .env. All secrets are references; code reads via validated config.
# See EI_POINT_VPS_BUILD_PLAN.md §4, §8.

# --- Postgres (local, single instance, per §4) ---
# Admin bootstraps the DB (superuser, compose only). App uses least-privilege login via roles.sql.
POSTGRES_ADMIN_USER=ei_point_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_32CHAR_MIN
POSTGRES_DB=ei_point
EI_APP_DB_USER=ei_point_app
EI_APP_DB_PASSWORD=CHANGE_ME_32CHAR_MIN_APP
DATABASE_URL=postgresql://ei_point_app:CHANGE_ME_32CHAR_MIN_APP@postgres:5432/ei_point

# --- Discord bots (6 identities: Kafka/Cyrene/Robin/Cipher/SilverWolf/Himiko; test-guild tokens first per §12) ---
DISCORD_KAFKA_BOT_TOKEN=
DISCORD_CYRENE_BOT_TOKEN=
DISCORD_ROBIN_BOT_TOKEN=
DISCORD_CIPHER_BOT_TOKEN=
DISCORD_SILVERWOLF_BOT_TOKEN=
DISCORD_HIMIKO_BOT_TOKEN=
# Legacy names (fallback only, remove after cutover):
DISCORD_SECURITY_BOT_TOKEN=
DISCORD_MODERATION_BOT_TOKEN=
DISCORD_COMMUNITY_BOT_TOKEN=
DISCORD_AI_BOT_TOKEN=
DISCORD_MUSIC_BOT_TOKEN=
DISCORD_COMMERCE_BOT_TOKEN=
COMMUNITY_GUILD_ALLOWLIST=
# Optional custom registered bot identity for the embed worker.
EMBED_WORKER_BOT_KEY=
EMBED_WORKER_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
DISCORD_MAIN_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback

# --- AI providers (external only; no CPU-local inference per §1) ---
AI_PROVIDER_PRIMARY=
AI_PROVIDER_PRIMARY_KEY=
AI_PROVIDER_FALLBACK=
AI_PROVIDER_FALLBACK_KEY=
AI_CONCURRENT=2
AI_QUEUE_MAX=20
AI_DEADLINE_MS=60000

# --- Cyrene TTS (voice playback; provider-agnostic) ---
TTS_PROVIDER_URL=
TTS_PROVIDER_KEY=
TTS_PROVIDER_NAME=default

# --- Commerce ---
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=Ei point
COMMERCE_GUILD_ID=
PAYMENT_ORIGIN=http://localhost:3000
USDT_TRC20_ADDRESS=
# Explicit operator quote required for USDT; never silently assume a live rate.
INR_PER_USDT=
USDT_REFERENCE_FEE=1
COMMERCE_REFERRAL_REWARD_MINOR=0
ORDER_TOKEN_SECRET=CHANGE_ME_32CHAR_MIN

# --- Web / API ---
SESSION_SECRET=CHANGE_ME_32CHAR_MIN
VAULT_SECRET=CHANGE_ME_32CHAR_MIN_DISTINCT_VAULT
INTERNAL_SERVICE_TOKEN=CHANGE_ME_32CHAR_MIN_INTERNAL
DASHBOARD_ADMIN_IDS=
DASHBOARD_ORIGIN=http://localhost:3000
CSRF_SECRET=CHANGE_ME_32CHAR_MIN
NEXT_PUBLIC_API_BASE=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Local HTTP development only; production Compose forces secure cookies.
COOKIE_SECURE=true
API_PORT=3001
WEB_PORT=3000

# --- Backups (§9) ---
PGBACKREST_REPO_PATH=/var/lib/pgbackrest
RESTIC_REPOSITORY=s3:https://s3.example.com/ei-point
RESTIC_PASSWORD=CHANGE_ME_32CHAR_MIN
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Tunnels (no public IP per benchmark) ---
# Exactly one of these is used; both go through local nginx.
TAILSCALE_FUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
