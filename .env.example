# Copy to .env Ã¢â‚¬â€ NEVER commit .env. All secrets are references; code reads via validated config.
# See EI_POINT_VPS_BUILD_PLAN.md Ã‚Â§4, Ã‚Â§8.
# Every entry below is read by code, compose, or scripts Ã¢â‚¬â€ verified 2026-10-13.
# Anything with a code default still listed here is operator-tunable.

# --- Postgres (local, single instance, per Ã‚Â§4) ---
# Admin bootstraps the DB (superuser, compose only). The app login lives
# inside DATABASE_URL; the maintenance migrator provisions its password and grants.
POSTGRES_ADMIN_USER=ei_point_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_32CHAR_MIN
POSTGRES_DB=ei_point
DATABASE_URL=postgresql://ei_point_app:CHANGE_ME_32CHAR_MIN_APP@postgres:5432/ei_point

# --- Discord bots (6 identities: Kafka/Cyrene/Robin/Cipher/SilverWolf/Himiko; test-guild tokens first per Ã‚Â§12) ---
EI_POINT_OWNER_ID=
EI_POINT_EMBED_IMAGE_URL=https://raw.githubusercontent.com/xyanncat/Ei-point/main/docs/assets/ei-point-pulse.gif
# Per-identity reply images: compose already defaults each bot to its own artwork in
# project assets/bots/<Bot>/embed.png (KAFKA, CYRENE, ROBIN, CIPHER, SILVERWOLF, HIMIKO).
# Set an EI_POINT_EMBED_IMAGE_<IDENTITY> override here only if a different image is needed.
DISCORD_KAFKA_BOT_TOKEN=
DISCORD_CYRENE_BOT_TOKEN=
DISCORD_ROBIN_BOT_TOKEN=
DISCORD_CIPHER_BOT_TOKEN=
DISCORD_SILVERWOLF_BOT_TOKEN=
DISCORD_HIMIKO_BOT_TOKEN=
# (Old pre-rename token names still work as silent fallbacks in code;
# you never need to set them Ã¢â‚¬â€ the 6 names above are the complete set.)
# Optional custom registered bot identity for the embed worker.
EMBED_WORKER_BOT_KEY=
EMBED_WORKER_BOT_TOKEN=
# The two servers, dev + main. Exactly these two IDs Ã¢â‚¬â€ every bot refuses
# to start with anything else, and the website refuses a third approval.
# (Compose builds GUILD_ALLOWLIST from these two; local runs read them directly.)
DISCORD_TEST_GUILD_ID=
DISCORD_MAIN_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback

# --- AI providers: external API or local OpenAI-compatible endpoint ---
# Local models (Qwen3-4B chat, Qwen3-TTS voice) work here too Ã¢â‚¬â€ point the URL
# at the local server (e.g. http://127.0.0.1:11434); local endpoints that need
# no key simply leave the KEY lines empty. Fallback covers the primary.
AI_PROVIDER_PRIMARY=
AI_PROVIDER_PRIMARY_KEY=
AI_PROVIDER_FALLBACK=
AI_PROVIDER_FALLBACK_KEY=
AI_DEADLINE_MS=60000
AI_DAILY_BUDGET_TOKENS=25000

# --- Cyrene TTS (local, offline Qwen3-TTS voice clone; no provider API key) ---
# Run scripts/prepare_qwen_model.py once with a pinned Hugging Face commit SHA.
QWEN_TTS_MODEL_PATH=../../.models/qwen3-tts-12hz-0.6b-base
QWEN_TTS_MODEL_REVISION=
# Keep the user-supplied reference clip outside Git and mount it read-only.
CYRENE_REFERENCE_AUDIO_PATH=../../.models/cyrene-reference.mp3
QWEN_TTS_REFERENCE_TEXT="Ah, there you are! Hehe, were you looking for me? Oh, don't look so surprised. I'm simply happy you're here. You know, even the smallest moments can become precious memories. So, shall we make another one together?"
QWEN_TTS_TORCH_THREADS=8
QWEN_TTS_QUEUE_MAX=2
QWEN_TTS_REQUEST_TIMEOUT_SECONDS=75

# --- Cyrene translation (local, offline Hy-MT2; no translation provider key) ---
# Prepare once with scripts/prepare_hymt2_model.py and a pinned 40-character revision.
HY_MT2_MODEL_PATH=../../.models/hy-mt2-1.8b
HY_MT2_THREADS=6
# Supplied persona memory is mounted read-only into bot-ai. Keep both source files private and out of Git.
CYRENE_PERSONA_MEMORY_FILE=../../.models/Cyrene_Chat_Roleplay_Memory.md

# --- Commerce ---
# Owner payment targets: public payment addresses shown to buyers, not credentials.
UPI_PAYEE_VPA=subrodeepadhikary-1@okhdfcbank
UPI_PAYEE_NAME="Ei point"
# Hosted Razorpay collection page (no API keys): https://razorpay.me/@<handle>
RAZORPAY_PAYMENT_PAGE=https://razorpay.me/@subrodluffy
COMMERCE_GUILD_ID=
PAYMENT_ORIGIN=http://localhost:3000
COMMERCE_REFERRAL_REWARD_MINOR=0
# Staff channel where fresh payment claims are announced (Cipher); empty = notifications off
COMMERCE_STAFF_CHANNEL_ID=

# --- Web / API ---
SESSION_SECRET=CHANGE_ME_32CHAR_MIN
VAULT_SECRET=CHANGE_ME_32CHAR_MIN_DISTINCT_VAULT
INTERNAL_SERVICE_TOKEN=CHANGE_ME_32CHAR_MIN_INTERNAL
DASHBOARD_ADMIN_IDS=
DASHBOARD_ORIGIN=http://localhost:3000
CSRF_SECRET=CHANGE_ME_32CHAR_MIN
NEXT_PUBLIC_API_BASE=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Local HTTP development only; production Compose forces secure cookies.
COOKIE_SECURE=true
API_PORT=3001

# --- Backups (Ã‚Â§9) ---
# Local 6-hour snapshots to /srv/backups need no credentials.
# Deployment rejects selected logical bundles older than 24 hours by default.
# Set only when an operator-approved release procedure uses a different bound.
DEPLOY_BACKUP_MAX_AGE_HOURS=24
# Off-host (pgBackRest/restic, see infra/backup/) stays dormant until an
# outer store exists Ã¢â‚¬â€ no keys listed until then.

# --- Tunnels (no public IP per benchmark) ---
# Exactly one of these is used; both go through local nginx.
# Nothing reads them yet Ã¢â‚¬â€ kept because the Cloudflare tunnel is next up.
TAILSCALE_FUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# Administrative migrations use a separate, one-shot container; never grant API superuser access.
MIGRATION_DATABASE_URL=postgresql://ei_point_admin:CHANGE_ME_32CHAR_MIN@postgres:5432/ei_point
# Trust exactly the nginx address, never arbitrary X-Forwarded-For clients.
APP_SUBNET=172.29.10.0/24
TRUSTED_PROXY_IP=172.29.10.250
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Optional encrypted off-host backup configuration; required to enable its timer.
ENV_FILE=/srv/ei-point/.env
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Explicit provider model IDs; configure the models actually served by each endpoint.
AI_PROVIDER_PRIMARY_MODEL=
AI_PROVIDER_FALLBACK_MODEL=
QWEN_TTS_STUCK_EXIT_SECONDS=60
QWEN_TTS_MKLDNN=auto
