# Copy to .env Ã¢â‚¬â€ NEVER commit .env. All secrets are references; code reads via validated config.
# See EI_POINT_VPS_BUILD_PLAN.md Ã‚Â§4, Ã‚Â§8.
# Neon live database (docs/operations/neon.md) and Drive backups (drive-backups.md).
# DATABASE_URL is the POOLED Neon URL with sslmode=require (bots + API).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ei_point?sslmode=require
# Neon free tier is the target (see docs/operations/neon.md): use the POOLED
# connection string with sslmode=require. The live database must NOT run on
# Google Drive — Drive has no file locking and cannot host Postgres.
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ei_point?sslmode=require

# --- Free-tier pacing (see docs/operations/neon.md) ---
# Background pumps run fast only while the bot is recently active, then back
# off. Never poll the database faster than every 5 minutes while idle: Neon
# free scales to zero and a constant poll exhausts the 100 CU-hours.
BOT_ACTIVE_POLL_SECONDS=5
BOT_IDLE_POLL_SECONDS=900
WORKER_POLL_SECONDS=900
COMMERCE_MAINTENANCE_SECONDS=900

# --- Discord bots (6 identities: Kafka/Cyrene/Robin/Cipher/SilverWolf/Himiko; test-guild tokens first per Ã‚Â§12) ---
EI_POINT_OWNER_ID=
EI_POINT_EMBED_IMAGE_URL=https://raw.githubusercontent.com/xyanncat/Ei-point/main/docs/assets/ei-point-pulse.gif
# Per-identity reply images: each bot defaults to its own artwork in
# project assets/bots/<Bot>/embed.png (KAFKA, CYRENE, ROBIN, CIPHER, SILVERWOLF, HIMIKO).
# Set an EI_POINT_EMBED_IMAGE_<IDENTITY> override here only if a different image is needed.
DISCORD_KAFKA_BOT_TOKEN=
DISCORD_CYRENE_BOT_TOKEN=
DISCORD_ROBIN_BOT_TOKEN=
DISCORD_CIPHER_BOT_TOKEN=
DISCORD_SILVERWOLF_BOT_TOKEN=
DISCORD_HIMIKO_BOT_TOKEN=
# (Old pre-rename token names still work as silent fallbacks in code;
# you never need to set them Ã¢â‚¬â€ the 6 names above are the complete set.)
# Optional custom registered bot identity for the embed worker.
EMBED_WORKER_BOT_KEY=
EMBED_WORKER_BOT_TOKEN=
# The two servers, dev + main. Exactly these two IDs Ã¢â‚¬â€ every bot refuses
# to start with anything else, and the website refuses a third approval.
# (Set GUILD_ALLOWLIST directly; the bots read it at startup.)
DISCORD_TEST_GUILD_ID=
DISCORD_MAIN_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback

# --- AI providers: external API or local OpenAI-compatible endpoint ---
# Local endpoints (self-hosted chat, local TTS) work here too; point the URL
# at the local server (e.g. http://127.0.0.1:11434); local endpoints that need
# no key simply leave the KEY lines empty. Fallback covers the primary.
# Groq (hosted, free tier): primary URL + model are the full request URL and
# the served model id.
#   AI_PROVIDER_PRIMARY=https://api.groq.com/openai/v1/chat/completions
#   AI_PROVIDER_PRIMARY_MODEL=openai/gpt-oss-20b
#   AI_PROVIDER_PRIMARY_KEY=<GROQ_API_KEY>
AI_PROVIDER_PRIMARY=
AI_PROVIDER_PRIMARY_KEY=
AI_PROVIDER_FALLBACK=
AI_PROVIDER_FALLBACK_KEY=
# Optional ceiling for the completion; unset = 1000, or 4096 for reasoning
# models (gpt-oss and friends), which spend part of the budget thinking.
AI_MAX_TOKENS=
AI_DEADLINE_MS=60000
AI_DAILY_BUDGET_TOKENS=25000

# --- Cyrene TTS (local Piper bridge on the phone, or a hosted provider) ---
# The local contract is POST TTS_URL {text,voice,format} and a raw WAV response;
# the phone's Piper bridge implements exactly that. The bot and bridge share
# the device, so loopback is correct; use the LAN address only if the bridge
# moves to another machine. Hosted providers are optional.
#   TTS_PROVIDER=local  -> same as unset (Piper bridge on the phone)
#   TTS_PROVIDER=google -> Google Cloud Text-to-Speech (GOOGLE_TTS_API_KEY)
#   TTS_PROVIDER=openai -> OpenAI-compatible /v1/audio/speech (TTS_PROVIDER_URL/KEY)
# Credentials are server-side only; never expose them to the browser.
TTS_PROVIDER=
TTS_PROVIDER_URL=
TTS_PROVIDER_KEY=
GOOGLE_TTS_API_KEY=
# Google only: en-US-Standard-C by default; a voice name or catalog id both work.
GOOGLE_TTS_VOICE=
# Daily character budgets admitted through PostgreSQL (per guild+user, then a
# global ceiling; redesign infrastructure §6). Unset = generous defaults.
TTS_DAILY_BUDGET_CHARS=
TTS_DAILY_BUDGET_CHARS_GLOBAL=
# One total deadline per synthesis INCLUDING queue wait, in seconds (default 90).
TTS_TOTAL_DEADLINE_SECONDS=
# Piper bridge on the phone (see docs/operations/phone-hosting.md).
TTS_URL=http://127.0.0.1:6006/tts
# --- Cyrene persona memory ---
# Supplied persona memory is mounted read-only into bot-ai. Keep both source files private and out of Git.
CYRENE_PERSONA_MEMORY_PATH=../../.models/Cyrene_Chat_Roleplay_Memory.md

# --- Commerce ---
# Owner payment targets: public payment addresses shown to buyers, not credentials.
UPI_PAYEE_VPA=subrodeepadhikary-1@okhdfcbank
UPI_PAYEE_NAME="Ei point"
# Hosted Razorpay collection page (no API keys): https://razorpay.me/@<handle>
RAZORPAY_PAYMENT_PAGE=https://razorpay.me/@subrodluffy
COMMERCE_GUILD_ID=
PAYMENT_ORIGIN=http://localhost:3000
COMMERCE_REFERRAL_REWARD_MINOR=0
# Staff channel where fresh payment claims are announced (Cipher); empty = notifications off
COMMERCE_STAFF_CHANNEL_ID=

# --- Web / API ---
# Public media origin (redesign infrastructure §5). Leave empty to serve the film,
# soundtrack and posters from this app's own /media/ paths.
# Example: https://storage.googleapis.com/ei-point-public-media/media
NEXT_PUBLIC_MEDIA_BASE_URL=
SESSION_SECRET=CHANGE_ME_32CHAR_MIN
VAULT_SECRET=CHANGE_ME_32CHAR_MIN_DISTINCT_VAULT
INTERNAL_SERVICE_TOKEN=CHANGE_ME_32CHAR_MIN_INTERNAL
# The role ladder. These are Discord user IDs, comma separated.
#   admin  owns the service catalogue (price, wording, add, remove) and sees
#          every order on the platform.
#   master outranks a server: sees every approved server, may edit any of
#          them, and no bot refuses their commands. Bots read the same value
#          (DASHBOARD_MASTER_IDS) to honour it.
# One identity each. Leave empty to fall back to the founding defaults.
DASHBOARD_ADMIN_IDS=
DASHBOARD_MASTER_IDS=
DASHBOARD_ORIGIN=http://localhost:3000
CSRF_SECRET=CHANGE_ME_32CHAR_MIN
NEXT_PUBLIC_API_BASE=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Production is HTTPS (Vercel + Render); local HTTP development may set false.
COOKIE_SECURE=true
API_PORT=3001

# --- Tunnels ---
# Optional external ingress for a self-run instance; unused by Render/Vercel.
TAILSCALE_FUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# Migrations run from the migrate-database workflow with the Neon direct URL.
MIGRATION_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/ei_point?sslmode=require
# Trust only the actual proxy (Vercel/Cloudflare) when X-Forwarded-For is used.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Explicit provider model IDs; configure the models actually served by each endpoint.
AI_PROVIDER_PRIMARY_MODEL=
AI_PROVIDER_FALLBACK_MODEL=
