[Unit]
Description=Ei Point encrypted off-host physical and artwork backup
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ei-point
Environment=ENV_FILE=/srv/ei-point/.env
ExecStart=/usr/bin/bash /srv/ei-point/infra/backup/restic-backup.sh
TimeoutStartSec=1h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
