[Unit]
Description=Ei Point logical and physical local backup
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/ei-point
Environment=ENV_FILE=/srv/ei-point/.env
ExecStart=/usr/bin/bash /srv/ei-point/infra/backup/local-backup.sh
TimeoutStartSec=5h
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
