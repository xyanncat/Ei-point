# Robin on the phone, inside proot Debian.
# Discord voice requires DAVE, whose `davey` wheel has no Android target, so
# Robin runs in Debian (glibc) rather than bare Termux. Copy this to
# /root/robin.env inside the Debian rootfs. Never commit real values.

BOT_KEY=robin
BOT_TOKEN=
GUILD_ALLOWLIST=
EI_POINT_OWNER_ID=

# Neon pooled connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ei_point?sslmode=require

# Cache inside the Debian rootfs (the phone has ~87 GB free).
CACHE_DIR=/root/music-cache
CACHE_MAX_BYTES=3000000000
CACHE_ITEM_MAX_BYTES=52428800
CACHE_TTL_SECONDS=604800
PLAYLIST_MAX_TRACKS=50

# yt-dlp fast path: hide /usr/local/bin (Deno/EJS solver) for ~2x faster
# extraction; the bot retries with EJS automatically if extraction fails.
YTDLP_FAST_PATH=/usr/bin:/bin

# Loopback health endpoint; reachable from the phone and ADB.
MUSIC_HEALTH_PORT=3105
