# Cyrene on the self-hosted device (same device as the Piper TTS bridge).
# Copy to the device as an untracked file; export it before starting bot-ai.
# Never commit real tokens, keys or the database URL.

BOT_KEY=cyrene
BOT_TOKEN=
GUILD_ALLOWLIST=
EI_POINT_OWNER_ID=

# Neon pooled connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ei_point?sslmode=require

# Chat stays hosted.
AI_PROVIDER_PRIMARY=https://api.groq.com/openai/v1/chat/completions
AI_PROVIDER_PRIMARY_MODEL=openai/gpt-oss-20b
AI_PROVIDER_PRIMARY_KEY=
AI_MAX_TOKENS=4096

# TTS is device-local: the bot posts {text,voice,format} to the Piper bridge
# and expects WAV. If the bridge ever moves to another machine, replace
# 127.0.0.1 with that machine's LAN address and allow TCP 3120.
TTS_PROVIDER=local
TTS_URL=http://127.0.0.1:3120/v1/audio/speech
TTS_TOTAL_DEADLINE_SECONDS=90
TTS_DAILY_BUDGET_CHARS=
TTS_DAILY_BUDGET_CHARS_GLOBAL=

# Persona memory is mounted/read locally; keep it out of Git.
CYRENE_PERSONA_MEMORY_FILE=/data/cyrene/Cyrene_Chat_Roleplay_Memory.md

# Free-tier pacing (Neon scale-to-zero).
BOT_ACTIVE_POLL_SECONDS=5
BOT_IDLE_POLL_SECONDS=900
NODE_OPTIONS=--max-old-space-size=384
