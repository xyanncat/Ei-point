# Cyrene on the self-hosted device (same device as the Cyrene TTS engine).
# Copy to the device as an untracked file; export it before starting bot-ai.
# Never commit real tokens, keys or the database URL.

BOT_KEY=cyrene
BOT_TOKEN=
GUILD_ALLOWLIST=
EI_POINT_OWNER_ID=

# Neon pooled connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ei_point?sslmode=require

# Chat stays hosted.
AI_PROVIDER_PRIMARY=https://api.groq.com/openai/v1/chat/completions
AI_PROVIDER_PRIMARY_MODEL=openai/gpt-oss-20b
AI_PROVIDER_PRIMARY_KEY=
AI_MAX_TOKENS=4096

# TTS is device-local: the bot posts {text,voice,format} to the Cyrene
# sherpa-onnx engine and expects WAV (the engine ignores the extra fields).
# The engine listens on 127.0.0.1:6006. If it ever moves to another machine,
# use that machine's LAN address.
TTS_PROVIDER=local
TTS_URL=http://127.0.0.1:6006/tts
TTS_TOTAL_DEADLINE_SECONDS=90
TTS_DAILY_BUDGET_CHARS=
TTS_DAILY_BUDGET_CHARS_GLOBAL=

# Persona memory is read locally; keep it out of Git. This is the variable
# the bot actually reads (CYRENE_PERSONA_MEMORY_PATH).
CYRENE_PERSONA_MEMORY_PATH=/data/data/com.termux/files/home/cyrene/Cyrene_Chat_Roleplay_Memory.md

# Free-tier pacing (Neon scale-to-zero).
BOT_ACTIVE_POLL_SECONDS=5
BOT_IDLE_POLL_SECONDS=900
NODE_OPTIONS=--max-old-space-size=384
