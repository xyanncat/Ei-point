# Resilient dependency downloads.
#
# Image builds run on hosts whose egress to registry.npmjs.org is slow and
# occasionally drops mid-install ("ERR_SOCKET_TIMEOUT"). The defaults (2 retries,
# 60s timeout, 16 concurrent socket fetches) fail on those links; the settings
# below trade a little wall-clock for a much higher success rate.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
network-concurrency=4
