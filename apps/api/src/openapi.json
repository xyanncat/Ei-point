{
  "openapi": "3.1.0",
  "info": {
    "title": "Ei Point dashboard foundation",
    "version": "1.0.0",
    "description": "Same-origin private dashboard API. Scopes are checked against current Discord membership and approved guilds. Health is service-wide; assignments and histories are guild-scoped."
  },
  "paths": {
    "/api/auth/me": {
      "get": {
        "operationId": "currentAccount",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "role",
                    "isAdmin",
                    "isMaster",
                    "expiresAt"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "role": {
                      "$ref": "#/components/schemas/Role"
                    },
                    "isAdmin": {
                      "type": "boolean"
                    },
                    "isMaster": {
                      "type": "boolean"
                    },
                    "realRole": {
                      "$ref": "#/components/schemas/Role"
                    },
                    "preview": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Master-only role preview under test (user|admin), otherwise null."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "operationId": "csrfToken",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrfToken"
                  ],
                  "properties": {
                    "csrfToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/guilds": {
      "get": {
        "operationId": "authorizedGuilds",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "guilds"
                  ],
                  "properties": {
                    "guilds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GuildInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "operationId": "guildServices",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "guildId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cards",
                    "stale"
                  ],
                  "properties": {
                    "cards": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ServiceCard"
                      }
                    },
                    "stale": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "operationId": "guildOverview",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "guildId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardOverview"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "operationId": "startOAuth",
        "responses": {
          "302": {
            "description": "Redirect to Discord; sets same-browser state cookie"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "operationId": "completeOAuth",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Persist encrypted server-side session and redirect to /dashboard"
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "operationId": "publicCatalog",
        "tags": [
          "catalogue"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/admin/catalog": {
      "get": {
        "operationId": "adminCatalog",
        "tags": [
          "catalogue"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogAdminItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "createCatalogItem",
        "tags": [
          "catalogue"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogSaveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "item"
                  ],
                  "properties": {
                    "item": {
                      "$ref": "#/components/schemas/CatalogAdminItem"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/admin/catalog/{sku}": {
      "put": {
        "operationId": "updateCatalogItem",
        "tags": [
          "catalogue"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogSaveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "item"
                  ],
                  "properties": {
                    "item": {
                      "$ref": "#/components/schemas/CatalogAdminItem"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "delete": {
        "operationId": "removeCatalogItem",
        "tags": [
          "catalogue"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "item"
                  ],
                  "properties": {
                    "item": {
                      "$ref": "#/components/schemas/CatalogAdminItem"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/master/guilds": {
      "get": {
        "operationId": "masterGuilds",
        "tags": [
          "master"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "guilds"
                  ],
                  "properties": {
                    "guilds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MasterGuild"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/master/guilds/{guildId}/bots/{botKey}": {
      "delete": {
        "operationId": "removeBotFromGuild",
        "tags": [
          "master"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "guildId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "botKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "botKey",
                    "guildId"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "botKey": {
                      "type": "string"
                    },
                    "guildId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/account/orders": {
      "get": {
        "operationId": "purchaseLogs",
        "tags": [
          "account"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "orders",
                    "scope"
                  ],
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PurchaseLogEntry"
                      }
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "own",
                        "all"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ei_session"
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "Sign-in required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Denied": {
        "description": "Guild access or CSRF denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Database or provider unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ServiceState": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "down",
          "unknown"
        ]
      },
      "ServiceCard": {
        "type": "object",
        "required": [
          "botKey",
          "state",
          "gateway",
          "dbReady",
          "latencyMs",
          "updatedAt"
        ],
        "properties": {
          "botKey": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stale": {
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "gateway": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "dbReady": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GuildInfo": {
        "type": "object",
        "required": [
          "guildId",
          "name",
          "approved"
        ],
        "properties": {
          "guildId": {
            "type": "string",
            "pattern": "^\\d{17,20}$"
          },
          "name": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "description": "Discord CDN icon hash for this guild, when Discord shares one."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "error",
          "retryable",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DashboardOverview": {
        "type": "object",
        "required": [
          "guild",
          "cards",
          "stale",
          "fetchedAt",
          "incidents",
          "actions"
        ],
        "properties": {
          "guild": {
            "$ref": "#/components/schemas/GuildInfo"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceCard"
            }
          },
          "stale": {
            "type": "boolean"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "incidents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "severity",
                "createdAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "key",
                "version",
                "changedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "version": {
                  "type": "integer"
                },
                "changedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "user",
          "admin",
          "master"
        ],
        "description": "user = a customer. admin = the operator: owns the service catalogue. master = outranks a server: sees every server and may remove a bot."
      },
      "CatalogItem": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "priceMinor",
          "currency"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceMinor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "game": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "membershipDays": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "CatalogAdminItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CatalogItem"
          },
          {
            "type": "object",
            "required": [
              "active"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "MasterGuild": {
        "type": "object",
        "required": [
          "guildId",
          "name",
          "ownerId",
          "approved",
          "bots"
        ],
        "properties": {
          "guildId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "bots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CatalogSaveRequest": {
        "type": "object",
        "required": [
          "name",
          "priceMinor"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
