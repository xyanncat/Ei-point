{
  "openapi": "3.1.0",
  "info": {
    "title": "Ei Point dashboard foundation",
    "version": "1.0.0",
    "description": "Same-origin private dashboard API. Scopes are checked against current Discord membership and approved guilds. Health is service-wide; assignments and histories are guild-scoped."
  },
  "paths": {
    "/api/auth/me": {
      "get": {
        "operationId": "currentAccount",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "expiresAt"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "operationId": "csrfToken",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrfToken"
                  ],
                  "properties": {
                    "csrfToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/guilds": {
      "get": {
        "operationId": "authorizedGuilds",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "guilds"
                  ],
                  "properties": {
                    "guilds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GuildInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "operationId": "guildServices",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "guildId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cards",
                    "stale"
                  ],
                  "properties": {
                    "cards": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ServiceCard"
                      }
                    },
                    "stale": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "operationId": "guildOverview",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "guildId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardOverview"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "403": {
            "$ref": "#/components/responses/Denied"
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "operationId": "startOAuth",
        "responses": {
          "302": {
            "description": "Redirect to Discord; sets same-browser state cookie"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "operationId": "completeOAuth",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Persist encrypted server-side session and redirect to /dashboard"
          },
          "401": {
            "$ref": "#/components/responses/AuthRequired"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ei_session"
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "Sign-in required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Denied": {
        "description": "Guild access or CSRF denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Database or provider unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ServiceState": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "down",
          "unknown"
        ]
      },
      "ServiceCard": {
        "type": "object",
        "required": [
          "botKey",
          "state",
          "gateway",
          "dbReady",
          "latencyMs",
          "updatedAt"
        ],
        "properties": {
          "botKey": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stale": {
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "gateway": {
            "$ref": "#/components/schemas/ServiceState"
          },
          "dbReady": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GuildInfo": {
        "type": "object",
        "required": [
          "guildId",
          "name",
          "approved"
        ],
        "properties": {
          "guildId": {
            "type": "string",
            "pattern": "^\\d{17,20}$"
          },
          "name": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "error",
          "retryable",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DashboardOverview": {
        "type": "object",
        "required": [
          "guild",
          "cards",
          "stale",
          "fetchedAt",
          "incidents",
          "actions"
        ],
        "properties": {
          "guild": {
            "$ref": "#/components/schemas/GuildInfo"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceCard"
            }
          },
          "stale": {
            "type": "boolean"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "incidents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "severity",
                "createdAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "key",
                "version",
                "changedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "version": {
                  "type": "integer"
                },
                "changedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
