{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "outDir": ".next",
    "rootDir": ".",
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": [
      "node"
    ],
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "components",
    "lib",
    ".next/types/**/*.ts",
    ".next-production/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
